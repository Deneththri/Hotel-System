NODE_ENV=development
HOST=127.0.0.1
PORT=3000
STORAGE_DRIVER=supabase
# Copy the Session pooler URI from Supabase Dashboard > Connect.
DATABASE_URL=
# Set this to the Supabase root certificate file if Node cannot verify TLS.
DATABASE_CA_CERT_PATH=prod-ca-2021.crt

# For a fresh production deployment, set a private initial manager password.
# ADMIN_PASSWORD=
# Optional. Set to the IP of the immediate trusted HTTP reverse proxy.
# TRUSTED_PROXY_IP=
# Set persistent storage paths on your host.
# DATA_DIR=
# OUTBOX_DIR=
